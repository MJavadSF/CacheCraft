{
  "name": "cache-craft-engine",
  "version": "1.0.0",
  "description": "Production-grade browser cache on IndexedDB/OPFS — isolated namespaces, cross-tab coherence, getOrSet with single-flight/SWR/retries, AES-GCM encryption with key rotation, rich serialization, memory tier, tag invalidation, budgets, devtools panel, and React/Vue/Svelte/TanStack Query/fetch integrations.",
  "author": {
    "name": "Mohammad Javad",
    "email": "mjavadsf72@gmail.com",
    "url": "https://github.com/MJavadSF"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      },
      "default": "./dist/react.js"
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      },
      "default": "./dist/vue.js"
    },
    "./svelte": {
      "import": {
        "types": "./dist/svelte.d.ts",
        "default": "./dist/svelte.js"
      },
      "require": {
        "types": "./dist/svelte.d.cts",
        "default": "./dist/svelte.cjs"
      },
      "default": "./dist/svelte.js"
    },
    "./tanstack-query": {
      "import": {
        "types": "./dist/tanstack-query.d.ts",
        "default": "./dist/tanstack-query.js"
      },
      "require": {
        "types": "./dist/tanstack-query.d.cts",
        "default": "./dist/tanstack-query.cjs"
      },
      "default": "./dist/tanstack-query.js"
    },
    "./fetch": {
      "import": {
        "types": "./dist/fetch.d.ts",
        "default": "./dist/fetch.js"
      },
      "require": {
        "types": "./dist/fetch.d.cts",
        "default": "./dist/fetch.cjs"
      },
      "default": "./dist/fetch.js"
    },
    "./opentelemetry": {
      "import": {
        "types": "./dist/opentelemetry.d.ts",
        "default": "./dist/opentelemetry.js"
      },
      "require": {
        "types": "./dist/opentelemetry.d.cts",
        "default": "./dist/opentelemetry.cjs"
      },
      "default": "./dist/opentelemetry.js"
    },
    "./devtools": {
      "import": {
        "types": "./dist/devtools.d.ts",
        "default": "./dist/devtools.js"
      },
      "require": {
        "types": "./dist/devtools.d.cts",
        "default": "./dist/devtools.cjs"
      },
      "default": "./dist/devtools.js"
    },
    "./plugins": {
      "import": {
        "types": "./dist/plugins.d.ts",
        "default": "./dist/plugins.js"
      },
      "require": {
        "types": "./dist/plugins.d.cts",
        "default": "./dist/plugins.cjs"
      },
      "default": "./dist/plugins.js"
    },
    "./admin": {
      "import": {
        "types": "./dist/admin.d.ts",
        "default": "./dist/admin.js"
      },
      "require": {
        "types": "./dist/admin.d.cts",
        "default": "./dist/admin.cjs"
      },
      "default": "./dist/admin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run test:coverage && npm run test:browser",
    "lint:package": "publint --strict && attw --pack . --profile node16",
    "size": "size-limit",
    "bench": "node bench/run.mjs",
    "verify": "npm run check && npm run typecheck && npm run test:all && npm run build && npm run lint:package && npm run size",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cache",
    "indexeddb",
    "client-side",
    "offline",
    "compression",
    "lru",
    "lfu",
    "encryption",
    "stale-while-revalidate",
    "browser-cache",
    "web-storage",
    "performance",
    "pwa",
    "offline-first",
    "typescript",
    "eviction",
    "monitoring",
    "nextjs",
    "react",
    "ssr-safe",
    "getorset",
    "cache-aside",
    "stampede",
    "single-flight",
    "tag-invalidation",
    "swr",
    "opfs",
    "origin-private-file-system",
    "vue",
    "svelte",
    "tanstack-query",
    "devtools",
    "service-worker",
    "web-locks",
    "namespaces",
    "key-rotation",
    "standard-schema",
    "fetch-cache"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MJavadSF/CacheCraft.git"
  },
  "bugs": {
    "url": "https://github.com/MJavadSF/CacheCraft/issues"
  },
  "homepage": "https://github.com/MJavadSF/CacheCraft#readme",
  "funding": {
    "type": "individual",
    "url": "https://reymit.ir/mjavadsf"
  },
  "contributors": [
    {
      "name": "MJ. Soleymani Fard",
      "email": "mjavadsf72@gmail.com",
      "url": "https://github.com/MJavadSF"
    },
    {
      "name": "Abbas Sourani",
      "email": "abbas.sourani.smartis@gmail.com",
      "url": "https://github.com/abbassius"
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.6.7",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "dexie": "^4.4.7",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.5",
    "idb-keyval": "^6.3.0",
    "localforage": "^1.10.0",
    "playwright": "^1.65.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "tinybench": "^6.2.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.45"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
