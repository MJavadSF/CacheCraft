{
  "name": "cache-craft-engine",
  "version": "0.3.0",
  "description": "Enterprise-grade IndexedDB caching library — SSR-safe, Next.js-ready, React-friendly, with plugins, encryption and advanced eviction strategies.",
  "author": {
    "name": "Mohammad Javad",
    "email": "mjavadsf72@gmail.com",
    "url": "https://github.com/MJavadSF"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types":   "./dist/index.d.ts",
      "import":  "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build":           "tsc --noEmit && rollup -c",
    "build:types":     "tsc --emitDeclarationOnly",
    "typecheck":       "tsc --noEmit",
    "prepublishOnly":  "npm run build",
    "test":            "jest",
    "test:watch":      "jest --watch",
    "lint":            "eslint src --ext .ts"
  },
  "keywords": [
    "cache",
    "indexeddb",
    "client-side",
    "offline",
    "compression",
    "lru",
    "lfu",
    "encryption",
    "stale-while-revalidate",
    "browser-cache",
    "web-storage",
    "performance",
    "pwa",
    "offline-first",
    "typescript",
    "eviction",
    "monitoring",
    "nextjs",
    "react",
    "ssr-safe"
  ],
  "repository": {
    "type": "git",
    "url":  "git+https://github.com/MJavadSF/CacheCraft.git"
  },
  "bugs": {
    "url": "https://github.com/MJavadSF/CacheCraft/issues"
  },
  "homepage": "https://github.com/MJavadSF/CacheCraft#readme",
  "funding": {
    "type": "individual",
    "url":  "https://reymit.ir/mjavadsf"
  },
  "contributors": [
    {
      "name":  "MJ. Soleymani Fard",
      "email": "mjavadsf72@gmail.com",
      "url":   "https://github.com/MJavadSF"
    },
    {
      "name":  "Abbas Sourani",
      "email": "abbas.sourani.smartis@gmail.com",
      "url":   "https://github.com/abbassius"
    }
  ],
  "devDependencies": {
    "@rollup/plugin-typescript":   "^12.3.0",
    "@types/jest":                 "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser":   "^8.59.1",
    "eslint":                      "^10.2.1",
    "fake-indexeddb":              "^6.2.5",
    "jest":                        "^30.3.0",
    "jest-environment-jsdom":      "^30.3.0",
    "rollup":                      "^4.60.2",
    "rollup-plugin-dts":           "^6.4.1",
    "ts-jest":                     "^29.4.9",
    "tslib":                       "^2.8.1",
    "typescript":                  "^5.9.3"
  }
}
