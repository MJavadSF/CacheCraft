{
  "name": "cache-craft-engine",
  "version": "0.5.0",
  "description": "Enterprise-grade IndexedDB caching library — SSR-safe, Next.js-ready, React-friendly, with an in-memory metadata index, cache-aside getOrSet with stampede protection, tag invalidation, atomic batch writes, plugins, encryption and advanced eviction strategies.",
  "author": {
    "name": "Mohammad Javad",
    "email": "mjavadsf72@gmail.com",
    "url": "https://github.com/MJavadSF"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      },
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run check && npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "cache",
    "indexeddb",
    "client-side",
    "offline",
    "compression",
    "lru",
    "lfu",
    "encryption",
    "stale-while-revalidate",
    "browser-cache",
    "web-storage",
    "performance",
    "pwa",
    "offline-first",
    "typescript",
    "eviction",
    "monitoring",
    "nextjs",
    "react",
    "ssr-safe",
    "getorset",
    "cache-aside",
    "stampede",
    "single-flight",
    "tag-invalidation",
    "swr"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MJavadSF/CacheCraft.git"
  },
  "bugs": {
    "url": "https://github.com/MJavadSF/CacheCraft/issues"
  },
  "homepage": "https://github.com/MJavadSF/CacheCraft#readme",
  "funding": {
    "type": "individual",
    "url": "https://reymit.ir/mjavadsf"
  },
  "contributors": [
    {
      "name": "MJ. Soleymani Fard",
      "email": "mjavadsf72@gmail.com",
      "url": "https://github.com/MJavadSF"
    },
    {
      "name": "Abbas Sourani",
      "email": "abbas.sourani.smartis@gmail.com",
      "url": "https://github.com/abbassius"
    }
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
